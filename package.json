{
  "name": "electron-fluent-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Electron starter with Vite, React, React Router and Fluent UI",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.74.4",
    "@fluentui/react-icons": "^2.0.333",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-vite": "^6.0.0-beta.1",
    "happy-dom": "^20.11.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.74.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
