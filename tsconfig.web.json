{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".types/web",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["src/renderer/**/*"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
